# Copy this file to .env (root) and fill in values.
# For local dev, also copy or symlink .env into frontend/ and backend/.

# Local (SQLite — change schema provider to "sqlite" in backend/prisma/schema.prisma):
# DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) — required for Vercel:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
